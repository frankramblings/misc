# SEC requires every API client to identify itself with a real contact.
# Format: "Name email@example.com"
EDGAR_USER_AGENT="Your Name your_email@example.com"

# Path to the config file. Defaults to ./config.toml if unset.
GOVSPEND_CONFIG=./config.toml

# Where the SQLite state DB lives. Defaults to ./data/state.db if unset.
GOVSPEND_DB=./data/state.db

# Where the JSONL event log lives. Defaults to ./data/events.jsonl if unset.
GOVSPEND_EVENTS=./data/events.jsonl
